# Local Flask server
APP_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-to-a-random-local-secret

# Leave this unset to use instance/mfuko.db automatically, or set it explicitly:
# DATABASE_URL=sqlite:///instance/mfuko.db

# Optional integrations. They are not required to run the local app.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=

# Required for STK push callbacks; use a publicly reachable HTTPS URL.
# MPESA_CALLBACK_URL=https://your-domain.example/mpesa/callback
# MPESA_ENVIRONMENT=sandbox
