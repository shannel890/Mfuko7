# Local Flask server
APP_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-this-to-a-random-local-secret

# Vercel Cron authentication. Configure this secret in the deployment dashboard.
# CRON_SECRET=generate-a-long-random-secret
# Required to use AI chat; loaded only when an AI request is made.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# PostgreSQL is the default runtime database. Use a separate database for tests.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/database?sslmode=require

# SQLite fallback for local work without PostgreSQL:
# DATABASE_URL=sqlite:///instance/mfuko.db

# Optional integrations. They are not required to run the local app.
# SECURITY_PASSWORD_SALT=generate-a-different-random-secret
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=

# Required for STK push callbacks; use a publicly reachable HTTPS URL.
# MPESA_CALLBACK_URL=https://your-domain.example/mpesa/callback
# MPESA_ENVIRONMENT=sandbox
